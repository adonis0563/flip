<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Group to scale and center our 100x100 custom monochrome logo to look balanced on launcher -->
    <group
        android:scaleX="0.65"
        android:scaleY="0.65"
        android:translateX="18.9"
        android:translateY="18.9">

        <!-- Left half of split-diamond (solid white) -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M 47,24 L 21,50 L 47,76 Z" />

        <!-- Right half of split-diamond (refined grey outline) -->
        <path
            android:fillColor="#888888"
            android:pathData="M 53,24 L 79,50 L 53,76 Z" />

        <!-- Inset contrast indicators -->
        <path
            android:fillColor="#111111"
            android:pathData="M 39,50 m -4,0 a 4,4 0 1,1 8,0 a 4,4 0 1,1 -8,0" />

        <path
            android:fillColor="#FFFFFF"
            android:pathData="M 61,50 m -4,0 a 4,4 0 1,1 8,0 a 4,4 0 1,1 -8,0" />
    </group>

</vector>
