<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Dark minimalist background circle to hold the design together on launcher -->
    <path
        android:fillColor="#111111"
        android:pathData="M 50,50 m -45,0 a 45,45 0 1,1 90,0 a 45,45 0 1,1 -90,0" />

    <!-- Left half of the split-diamond (white/silver) representing send/receive state -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 47,24 L 21,50 L 47,76 Z" />

    <!-- Right half of the split-diamond (muted gray/outline) representing opposing state -->
    <path
        android:fillColor="#888888"
        android:pathData="M 53,24 L 79,50 L 53,76 Z" />

    <!-- Inset inverse indicators -->
    <path
        android:fillColor="#111111"
        android:pathData="M 39,50 m -4,0 a 4,4 0 1,1 8,0 a 4,4 0 1,1 -8,0" />

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 61,50 m -4,0 a 4,4 0 1,1 8,0 a 4,4 0 1,1 -8,0" />

</vector>
